<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Browse Available Pets</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header><h1>Available Pets for Adoption</h1></header>
    <main>
        <div class="pet">
            <img src="dog1.jpg" alt="Cute Dog">
            <p><strong>Name:</strong> Max</p>
            <p><strong>Age:</strong> 2 years</p>
            <p><strong>Breed:</strong> Golden Retriever</p>
            <button>Interested</button>
        </div>
        <div class="pet">
            <img src="cat1.jpg" alt="Cute Cat">
            <p><strong>Name:</strong> Whiskers</p>
            <p><strong>Age:</strong> 3 years</p>
            <p><strong>Breed:</strong> Persian</p>
            <button>Interested</button>
        </div>
    </main>
</body>
</html>
