<!DOCTYPE HTML5>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Available Pets</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: #333;
    }

    .pet-list {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .pet-card {
      background-color: #fff;
      border: 1px solid #ddd;
      border-radius: 10px;
      width: 200px;
      box-shadow: 2px 2px 10px rgba(0,0,0,0.1);
      text-align: center;
      padding: 10px;
    }

    .pet-card img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 8px;
    }

    .pet-card h3 {
      margin: 10px 0 5px;
    }

    .pet-card p {
      color: #666;
      font-size: 14px;
    }
  </style>
</head>
<body>

  <h1>Available Pets for Adoption</h1>

  <div class="pet-list">
    <div class="pet-card">
      <img src="Labrador.jpeg" alt="Dog">
      <h3>Bao</h3>
      <p>2 years old • Labrador</p>
    </div>

    <div class="pet-card">
      <img src="Siamese.jpeg" alt="Cat">
      <h3>Luna</h3>
      <p>1 year old • Siamese</p>
    </div>

    <div class="pet-card">
      <img src="german-shepherd.jpeg" alt="Dog">
      <h3>Max</h3>
      <p>3 years old • German Shepherd</p>
    </div>

    <div class="pet-card">
      <img src="calico.jpeg" alt="Cat">
      <h3>Katie</h3>
      <p>4 months old • Calico</p>
    </div>
  </div>

</body>
</html>